{
  "name": "yol-malumoti",
  "version": "1.0.0",
  "private": true,
  "description": "Yol Ma'lumoti — Road information and accessible navigation platform for Uzbekistan",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node dev.js",
    "dev:api": "npm run dev --workspace=@yol/api",
    "dev:web": "npm run dev --workspace=@yol/web",
    "build": "npm run build --workspaces",
    "start": "node apps/api/dist/server.js",
    "test": "npm run test --workspace=@yol/api"
  },
  "keywords": [
    "road-information",
    "accessibility",
    "maplibre",
    "uzbekistan",
    "tashkent",
    "weather",
    "air-quality"
  ],
  "author": "Yol Ma'lumoti Team",
  "license": "MIT"
}
